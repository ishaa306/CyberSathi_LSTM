# =================================================================
# CyberSaathi - .gitignore
# =================================================================

# --- Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
backend/venv/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/

# --- Environment & Secret Variables ---
.env
*.env
!.env.example
!backend/.env.example
frontend/.env
backend/.env

# --- Databases & Local Storage ---
backend/cybercrime.db
cybercrime.db
*.sqlite
*.sqlite3
*.db

# --- Uploaded Evidence & User Data (Keep directories via .gitkeep) ---
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/app/uploads/*
!backend/app/uploads/.gitkeep

# --- Legacy Scikit-Learn Model Binaries (Regenerated by script) ---
backend/app/ml/artifacts/*.joblib
backend/models/*.joblib
backend/models/*.pkl

# --- Node.js & Frontend Build Outputs ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.eslintcache

# --- OS & Editor Specific Files ---
.DS_Store
.idea/
.vscode/
*.log
Thumbs.db
*.swp
*.swo

# --- Primary CyberSaathi LSTM Production Artifacts (MUST BE TRACKED) ---
!cybersaathi_lstm_unweighted/
!cybersaathi_lstm_unweighted/*
